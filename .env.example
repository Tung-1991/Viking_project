DNSE_API_KEY=
DNSE_API_SECRET=
DNSE_ACCOUNT_NO=
DNSE_STOCK_ACCOUNT_NO=
DNSE_DERIVATIVE_ACCOUNT_NO=
DNSE_CUSTODY_CODE=
DNSE_OTP_TYPE=email_otp
DNSE_BASE_URL=https://openapi.dnse.com.vn
DNSE_API_VERSION=2026-05-07
DNSE_CKCS_WATCHLIST=FPT,SSI,VCB,CTG,BID,MBB
DNSE_CKPS_WATCHLIST=VN30F1M
PAPER_TRADING=True
AUTO_TRADE_ENABLED=False
# Số dư ảo khi chạy paper (VND). Chỉnh được ở UI: ⚙ PRESET → tab Paper.
PAPER_INITIAL_BALANCE=100000000.0

# --- Luật cổ phiếu cơ sở (CKCS) ---
# Map mã -> sàn để tính biên trần/sàn, dạng "SHS:HNX,ABC:UPCOM". Để trống = HOSE (±7%).
DNSE_STOCK_EXCHANGE_MAP=

# --- Market-data WebSocket streaming (giảm tải REST để add nhiều mã không bị BAN) ---
# Bật true để stream giá qua WebSocket thay vì poll REST. Mặc định false (dùng REST + cache).
DNSE_WS_MODE=auto
# Legacy compatibility only; use DNSE_WS_MODE=off to disable streaming.
DNSE_WS_ENABLED=true
DNSE_WS_URL=wss://ws-openapi.dnse.com.vn
DNSE_WS_ENCODING=json
DNSE_WS_BOARD_ID=G1
DNSE_WS_RECONCILE_SECONDS=30
MARKET_PREOPEN_MINUTES=5
MARKET_HOLIDAYS=
ADVISOR_API_TIMEOUT_SECONDS=300
ADVISOR_API_RETRIES=2
DNSE_DERIVATIVE_TAX_RATE=0.001
DNSE_STOCK_TAX_RATE=0.001
DNSE_DERIVATIVE_INITIAL_MARGIN_RATE=0.20
MONEY_DISPLAY_ZERO_TRIM=000

# CKCS RAW DATA: collect one aggregate record per symbol/day.
SCAN_SNAPSHOT_ENABLED=true
SCAN_SNAPSHOT_INTERVAL_MINUTES=15
SCAN_SNAPSHOT_RETENTION_DAYS=250

# --- TTL cache REST (giây): tăng = gọi API ít hơn (an toàn rate-limit), giảm = cập nhật nhanh hơn ---
DNSE_TICK_CACHE_TTL_SECONDS=2.0
DNSE_OHLC_CACHE_TTL_SECONDS=30.0
DNSE_ACCOUNT_CACHE_TTL_SECONDS=5.0
DNSE_POSITIONS_CACHE_TTL_SECONDS=5.0
DNSE_ORDERS_CACHE_TTL_SECONDS=5.0
DNSE_CLOSED_PRIVATE_SYNC_SECONDS=300.0
DNSE_BROKER_BACKOFF_SECONDS=60.0
DNSE_ACCOUNT_REPOSITORY_BACKOFF_SECONDS=60.0
